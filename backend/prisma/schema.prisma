// Prisma schema for the CENTO multi-tenant e-commerce backend.
// Docs: https://www.prisma.io/docs
//
// Two rules shape everything below.
//
// 1. THE CATALOG HIERARCHY IS FIXED AND TOTAL:
//
//      Tenant → Category → Company → ProductType → Model → Product
//
//    Each level is its own table with a required foreign key to its parent, so
//    the hierarchy is enforced by the database rather than by application code.
//    A Product cannot exist without a Model, a Model cannot exist without a
//    ProductType, and so on up to the Tenant. Orphans are structurally
//    impossible, not merely discouraged.
//
// 2. EVERY BUSINESS ROW BELONGS TO EXACTLY ONE TENANT. Catalog and commerce
//    tables all carry `tenantId`. Child tables (OrderItem, CartItem,
//    ProductImage, …) inherit their tenant through their parent instead of
//    duplicating the column, which is what stops the two from ever disagreeing.

generator client {
  provider      = "prisma-client-js"
  // "native" covers local dev (e.g. Windows); the debian target matches the
  // node:22-bookworm-slim container the backend runs in.
  binaryTargets = ["native", "debian-openssl-3.0.x", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  // Runtime queries go through Supabase's transaction pooler (port 6543), which
  // is what makes this safe to run in serverless functions.
  url      = env("DATABASE_URL")
  // Migrations and introspection need a session-mode connection (port 5432):
  // DDL and advisory locks cannot cross a transaction pooler.
  directUrl = env("DIRECT_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

/// Application roles. Drives RBAC. CUSTOMER is the storefront role; the rest
/// are staff roles with access to the admin console (scoped per-permission).
/// A SUPER_ADMIN with no tenant is the platform operator and may act across
/// tenants; every other role is confined to its own tenant.
enum Role {
  SUPER_ADMIN
  ADMIN
  MANAGER
  SUPPORT
  CUSTOMER
}

/// Lifecycle state of any user account.
enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

/// One-time code purpose. Used for the register/verify-OTP and reset flows.
enum VerificationTokenType {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

enum TenantStatus {
  ACTIVE
  SUSPENDED
}

/// Shared by all four catalog levels: archiving a node retires it from the
/// admin's working set without deleting history.
enum CatalogStatus {
  ACTIVE
  ARCHIVED
}

/// Shared by all four catalog levels. Hiding a level hides everything beneath
/// it from the storefront — enforced in the query layer, not by cascade.
enum CatalogVisibility {
  VISIBLE
  HIDDEN
}

/// Product publication state. SCHEDULED goes live on `scheduledDate`.
enum ProductVisibility {
  PUBLIC
  PRIVATE
  SCHEDULED
}

/// Derived from stock level; persisted so the admin list can filter on it.
enum StockStatus {
  IN_STOCK
  LOW_STOCK
  OUT_OF_STOCK
}

enum OrderStatus {
  PENDING
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  RETURNED
}

/// Settlement state of an order, tracked independently of fulfilment status.
enum PaymentStatus {
  PAID
  PENDING
  REFUNDED
  FAILED
}

enum DiscountType {
  PERCENTAGE
  FIXED_AMOUNT
}

/// Lifecycle bucket that drives the Active / Scheduled / Archived tabs.
enum DiscountCategory {
  ACTIVE
  SCHEDULED
  ARCHIVED
}

enum MessageDirection {
  INCOMING
  OUTGOING
}

enum NotificationType {
  SUCCESS
  INFO
  WARNING
  ERROR
}

enum NotificationCategory {
  ORDERS
  CUSTOMERS
  INVENTORY
  DISCOUNTS
  REPORTS
  SYSTEM
}

enum BannerType {
  HERO
  PROMOTIONAL
  SIDEBAR
}

enum FeaturedSection {
  BEST_SELLERS
  NEW_ARRIVALS
  SALE
}

// ---------------------------------------------------------------------------
// Tenancy
// ---------------------------------------------------------------------------

/// One storefront + admin workspace. Everything a tenant owns hangs off this
/// row, and every tenant-scoped query filters on `tenantId` before anything
/// else, so one tenant can never read or write another's data.
model Tenant {
  id     String       @id @default(cuid())
  name   String
  /// Stable identifier used in URLs and the X-Tenant-Slug header.
  slug   String       @unique
  /// Host that maps to this tenant, e.g. "parts.example.com". The storefront
  /// resolves its tenant from the request Host header via this column.
  domain String?      @unique
  status TenantStatus @default(ACTIVE)

  logoUrl      String?
  contactEmail String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users                User[]
  categories           Category[]
  companies            Company[]
  productTypes         ProductType[]
  models               Model[]
  products             Product[]
  orders               Order[]
  discounts            Discount[]
  banners              Banner[]
  featuredProducts     FeaturedProduct[]
  carts                Cart[]
  wishlists            Wishlist[]
  conversations        Conversation[]
  notifications        Notification[]
  inventoryAdjustments InventoryAdjustment[]
  stockNotifications   StockNotification[]

  @@index([status])
}

// ---------------------------------------------------------------------------
// Auth & users
// ---------------------------------------------------------------------------

/// A single users table serves both staff (admin console) and customers.
/// The admin "Customers" screen is simply `where role = CUSTOMER`.
model User {
  id            String     @id @default(cuid())
  /// Null only for the platform operator (a SUPER_ADMIN who administers every
  /// tenant). Every other account, staff or customer, belongs to one tenant.
  tenantId      String?
  /// Cascade, like every other tenant-owned table: deleting a store removes the
  /// accounts that only existed inside it. The delete endpoint spells out how
  /// many accounts that is and demands the slug as confirmation first.
  tenant        Tenant?    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  email         String
  passwordHash  String
  fullName      String
  phone         String?
  role          Role       @default(CUSTOMER)
  status        UserStatus @default(ACTIVE)
  emailVerified Boolean    @default(false)
  avatarUrl     String?
  /// When the account holder accepted the membership terms. Null for accounts
  /// created before consent was recorded (e.g. seeded staff), so it is nullable
  /// rather than defaulted — a synthetic timestamp would misrepresent consent.
  termsAcceptedAt DateTime?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  refreshTokens      RefreshToken[]
  verificationTokens VerificationToken[]
  addresses          Address[]
  carts              Cart[]
  wishlists          Wishlist[]
  orders             Order[]
  conversations      Conversation[]
  notifications      Notification[]
  inventoryLogs      InventoryAdjustment[]
  stockNotifications StockNotification[]

  /// Scoped to the tenant, not global: the same person may hold an account on
  /// two different storefronts, exactly as they would with two separate shops.
  @@unique([tenantId, email])
  @@index([tenantId, role])
  @@index([role])
  @@index([status])
  @@index([email])
}

/// Hashed refresh tokens (rotating). One row per active session/device.
model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  userAgent String?
  ip        String?
  createdAt DateTime  @default(now())

  @@index([userId])
}

/// Hashed one-time codes for email verification and password reset.
model VerificationToken {
  id         String                @id @default(cuid())
  userId     String
  user       User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  type       VerificationTokenType
  codeHash   String
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime              @default(now())

  @@index([userId, type])
}

/// Shipping/billing addresses. Rendered one line per array entry in the UI.
model Address {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  label     String?
  lines     String[]
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

// ---------------------------------------------------------------------------
// Catalog hierarchy — Category > Company > ProductType > Model > Product
//
// The four taxonomy levels share a deliberate shape (name, slug, description,
// imageUrl, status, visibility, position, SEO), so the admin CRUD, the DTOs and
// the frontend screens for them are all structurally identical. What differs is
// only the parent each one requires.
//
// Slugs are unique per parent rather than globally: "chairs" may exist under
// both IKEA and WoodCraft, and two tenants may both have "electronics".
// Deletes are Restrict everywhere — the API refuses to remove a level that
// still has children or products, and offers an explicit cascade instead.
// ---------------------------------------------------------------------------

/// Level 1. Top of the tree, e.g. "Electronics", "Furniture", "Hardware".
model Category {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  name        String
  slug        String
  description String  @default("")
  /// Icon key rendered by the frontend (lucide name).
  icon        String?
  imageUrl    String?
  /// Filename/size of the uploaded tile image, shown in the admin form.
  thumbnailName String?
  thumbnailSize String?

  status     CatalogStatus     @default(ACTIVE)
  visibility CatalogVisibility @default(VISIBLE)
  /// Sort order among siblings; drives storefront menu order.
  position   Int               @default(0)

  metaTitle       String?
  metaDescription String?

  /// True for rows the hierarchy migration invented so existing products had a
  /// parent to hang from (the "Unclassified" category, "General" companies,
  /// product types and models). They are a to-do list, not real catalog: filter
  /// on this to build a "needs filing" view, and clear the flag once a human
  /// has confirmed the node is genuine.
  isPlaceholder Boolean @default(false)

  companies Company[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, slug])
  @@index([tenantId, status])
  @@index([tenantId, isPlaceholder])
  @@index([tenantId, position])
}

/// Level 2. A brand inside one category, e.g. "Samsung" under Electronics.
model Company {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  name        String
  slug        String
  description String  @default("")
  /// Brand logo.
  imageUrl    String?

  status     CatalogStatus     @default(ACTIVE)
  visibility CatalogVisibility @default(VISIBLE)
  position   Int               @default(0)

  metaTitle       String?
  metaDescription String?

  /// True for rows the hierarchy migration invented so existing products had a
  /// parent to hang from (the "Unclassified" category, "General" companies,
  /// product types and models). They are a to-do list, not real catalog: filter
  /// on this to build a "needs filing" view, and clear the flag once a human
  /// has confirmed the node is genuine.
  isPlaceholder Boolean @default(false)

  productTypes ProductType[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([categoryId, slug])
  @@index([tenantId])
  @@index([categoryId, position])
  @@index([tenantId, status])
  @@index([tenantId, isPlaceholder])
}

/// Level 3. A product line inside one company, e.g. "Mobile Phones", "Chairs".
model ProductType {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Restrict)

  name        String
  slug        String
  description String  @default("")
  imageUrl    String?

  status     CatalogStatus     @default(ACTIVE)
  visibility CatalogVisibility @default(VISIBLE)
  position   Int               @default(0)

  metaTitle       String?
  metaDescription String?

  /// True for rows the hierarchy migration invented so existing products had a
  /// parent to hang from (the "Unclassified" category, "General" companies,
  /// product types and models). They are a to-do list, not real catalog: filter
  /// on this to build a "needs filing" view, and clear the flag once a human
  /// has confirmed the node is genuine.
  isPlaceholder Boolean @default(false)

  models Model[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, slug])
  @@index([tenantId])
  @@index([companyId, position])
  @@index([tenantId, status])
  @@index([tenantId, isPlaceholder])
}

/// Level 4. A specific model inside one product type, e.g. "Galaxy S25",
/// "AB8". Products (spare parts, components, accessories) hang off this.
model Model {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  productTypeId String
  productType   ProductType @relation(fields: [productTypeId], references: [id], onDelete: Restrict)

  name        String
  slug        String
  description String  @default("")
  imageUrl    String?

  status     CatalogStatus     @default(ACTIVE)
  visibility CatalogVisibility @default(VISIBLE)
  position   Int               @default(0)

  /// Optional release year, useful for sorting long model lists (iPhone 6 … 17).
  releaseYear Int?

  metaTitle       String?
  metaDescription String?

  /// True for rows the hierarchy migration invented so existing products had a
  /// parent to hang from (the "Unclassified" category, "General" companies,
  /// product types and models). They are a to-do list, not real catalog: filter
  /// on this to build a "needs filing" view, and clear the flag once a human
  /// has confirmed the node is genuine.
  isPlaceholder Boolean @default(false)

  products Product[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([productTypeId, slug])
  @@index([tenantId])
  @@index([productTypeId, position])
  @@index([tenantId, status])
  @@index([tenantId, isPlaceholder])
}

/// Level 5. A sellable item, always inside exactly one Model. `modelId` is
/// required: there is no such thing as an unclassified product.
model Product {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  modelId String
  model   Model  @relation(fields: [modelId], references: [id], onDelete: Restrict)

  name          String
  description   String            @default("")
  sku           String
  stock         Int               @default(0)
  status        StockStatus       @default(IN_STOCK)
  price         Decimal           @db.Decimal(12, 2)
  discount      Int               @default(0)
  visibility    ProductVisibility @default(PUBLIC)
  scheduledDate DateTime?
  tags          String[]
  unitValue     Decimal?          @db.Decimal(12, 2)

  images           ProductImage[]
  variants         ProductVariant[]
  orderItems       OrderItem[]
  cartItems        CartItem[]
  wishlistItems    WishlistItem[]
  inventoryLogs    InventoryAdjustment[]
  featuredProducts FeaturedProduct[]
  stockNotifications StockNotification[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// SKUs only have to be unique within a tenant — two shops may legitimately
  /// use the same part number.
  @@unique([tenantId, sku])
  @@index([tenantId, modelId])
  @@index([modelId])
  @@index([tenantId, status])
  @@index([tenantId, visibility])
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  position  Int     @default(0)

  @@index([productId])
}

model ProductVariant {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  name      String

  cartItems CartItem[]

  @@index([productId])
}

/// Audit trail for stock changes, powering the Inventory screen's history.
model InventoryAdjustment {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  delta     Int
  reason    String?
  byUserId  String?
  byUser    User?    @relation(fields: [byUserId], references: [id])
  createdAt DateTime @default(now())

  @@index([productId])
  @@index([tenantId])
}

/// A shopper waiting for an out-of-stock product to come back.
///
/// Created from the storefront's "Notify me" button and discharged the moment
/// stock rises above zero, which is the only event that can satisfy it. Rows
/// are kept after notifying rather than deleted, so the same person asking
/// again later reuses the row and the admin can still see who asked.
model StockNotification {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  /// Where to write. Captured even for signed-in shoppers, so a later change of
  /// account email cannot silently redirect a promise already made.
  email  String
  /// Set when the request came from a signed-in shopper; null for a guest.
  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  /// Null while still waiting. Set when the back-in-stock mail goes out, which
  /// is also what stops one restock mailing the same person twice.
  notifiedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// One row per person per product; asking twice re-arms the existing row.
  @@unique([productId, email])
  @@index([tenantId])
  /// The restock query: everyone still waiting on one product.
  @@index([productId, notifiedAt])
}

// ---------------------------------------------------------------------------
// Shopping Cart
// ---------------------------------------------------------------------------

model Cart {
  id        String     @id @default(cuid())
  tenantId  String
  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId    String? // Null for guest carts
  user      User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessionId String?    @unique // For guest cart tracking via cookie/localStorage
  items     CartItem[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@index([tenantId])
  @@index([userId])
  @@index([sessionId])
}

model CartItem {
  id        String   @id @default(cuid())
  cartId    String
  cart      Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id])
  quantity  Int      @default(1)
  unitPrice Decimal  @db.Decimal(12, 2) // Price snapshot when added to cart
  /// The ProductVariant the shopper picked. Required at the API level whenever
  /// the product defines variants; nullable here because most products don't.
  /// SetNull rather than Cascade: deleting a variant must not silently empty
  /// someone's cart.
  variantId String?
  variant   ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  color     String? // Legacy free-text variant, superseded by variantId
  size      String? // Legacy free-text variant, superseded by variantId
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([cartId])
  @@index([productId])
  @@index([variantId])
}

// ---------------------------------------------------------------------------
// Wishlist
// ---------------------------------------------------------------------------

model Wishlist {
  id        String        @id @default(cuid())
  tenantId  String
  tenant    Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     WishlistItem[]
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([tenantId])
  @@index([userId])
}

model WishlistItem {
  id         String   @id @default(cuid())
  wishlistId String
  wishlist   Wishlist @relation(fields: [wishlistId], references: [id], onDelete: Cascade)
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([wishlistId, productId]) // Prevent duplicate items
  @@index([wishlistId])
  @@index([productId])
}

// ---------------------------------------------------------------------------
// Homepage & Featured Content
// ---------------------------------------------------------------------------

model Banner {
  id             String     @id @default(cuid())
  tenantId       String
  tenant         Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  type           BannerType
  title          String
  description    String?
  imageUrl       String
  mobileImageUrl String?
  linkUrl        String?
  linkText       String?
  isActive       Boolean    @default(true)
  displayOrder   Int        @default(0)
  startDate      DateTime?
  endDate        DateTime?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  @@index([tenantId, type, isActive])
  @@index([displayOrder])
}

model FeaturedProduct {
  id           String          @id @default(cuid())
  tenantId     String
  tenant       Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  section      FeaturedSection
  productId    String
  product      Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  displayOrder Int             @default(0)
  isActive     Boolean         @default(true)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@unique([section, productId, displayOrder])
  @@index([tenantId, section, isActive])
  @@index([displayOrder])
}

// ---------------------------------------------------------------------------
// Orders
// ---------------------------------------------------------------------------

model Order {
  id               String        @id @default(cuid())
  tenantId         String
  tenant           Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  /// Human-facing order number, e.g. "ORD-2024-8841". Unique per tenant.
  orderNumber      String
  customerId       String?
  customer         User?         @relation(fields: [customerId], references: [id])
  status           OrderStatus   @default(PENDING)
  paymentStatus    PaymentStatus @default(PENDING)
  paymentMethod    String?
  shippingMethod   String?
  shippingTracking String?
  shippingAddress  String[]
  shippingCost     Decimal       @default(0) @db.Decimal(12, 2)
  discount         Decimal       @default(0) @db.Decimal(12, 2)
  placedAt         DateTime      @default(now())
  items            OrderItem[]
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@unique([tenantId, orderNumber])
  @@index([tenantId, status])
  @@index([customerId])
  @@index([paymentStatus])
}

model OrderItem {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String?
  product   Product? @relation(fields: [productId], references: [id])
  name      String
  sku       String
  /// Snapshot of the chosen variant's name, like `name` and `sku`. Stored as
  /// text rather than a relation so renaming or deleting a variant can never
  /// rewrite what a customer actually ordered.
  variantName String?
  /// Snapshot of where the product sat in the catalog when it was ordered.
  /// Reports read these instead of walking Model→ProductType→Company→Category,
  /// so restructuring the catalog can never rewrite historical figures.
  categoryName    String?
  companyName     String?
  productTypeName String?
  modelName       String?
  quantity  Int
  unitPrice Decimal  @db.Decimal(12, 2)

  @@index([orderId])
}

// ---------------------------------------------------------------------------
// Discounts
// ---------------------------------------------------------------------------

model Discount {
  id         String           @id @default(cuid())
  tenantId   String
  tenant     Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name       String
  code       String
  type       DiscountType
  value      Decimal          @db.Decimal(12, 2)
  category   DiscountCategory @default(ACTIVE)
  icon       String?
  usageLimit Int              @default(0)
  usageCount Int              @default(0)
  startDate  DateTime
  endDate    DateTime
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  @@unique([tenantId, code])
  @@index([tenantId, category])
}

// ---------------------------------------------------------------------------
// Messages (customer support chat)
// ---------------------------------------------------------------------------

model Conversation {
  id            String    @id @default(cuid())
  tenantId      String
  tenant        Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customerId    String
  customer      User      @relation(fields: [customerId], references: [id], onDelete: Cascade)
  lastMessageAt DateTime  @default(now())
  unreadCount   Int       @default(0)
  messages      Message[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([tenantId])
  @@index([customerId])
}

model Message {
  id             String           @id @default(cuid())
  conversationId String
  conversation   Conversation     @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  direction      MessageDirection
  text           String
  createdAt      DateTime         @default(now())

  @@index([conversationId])
}

// ---------------------------------------------------------------------------
// Notifications
// ---------------------------------------------------------------------------

model Notification {
  id          String               @id @default(cuid())
  tenantId    String
  tenant      Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  /// Target admin user. Null = broadcast to every admin of the tenant.
  userId      String?
  user        User?                @relation(fields: [userId], references: [id], onDelete: Cascade)
  type        NotificationType
  category    NotificationCategory
  title       String
  description String
  read        Boolean              @default(false)
  createdAt   DateTime             @default(now())

  @@index([tenantId, read])
  @@index([userId])
}

// ---------------------------------------------------------------------------
// Settings (flexible key/value store for the Settings screen)
//
// Platform-level and therefore deliberately NOT tenant-scoped.
// ---------------------------------------------------------------------------

model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}
