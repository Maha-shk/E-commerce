# =============================================================================
# CENTO Backend - Production Environment Variables
# =============================================================================
# Use this as a reference when deploying to Railway, Render, or similar

# =============================================================================
# Runtime Configuration
# =============================================================================
NODE_ENV=production
PORT=4000

# =============================================================================
# Database (PostgreSQL)
# =============================================================================
# Railway/Render will provide this automatically
# For manual setup, use: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL=

# =============================================================================
# JWT Authentication
# =============================================================================
# Generate these with: openssl rand -base64 48
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# =============================================================================
# CORS Configuration
# =============================================================================
# Your deployed frontend URL
CORS_ORIGIN=https://your-frontend.vercel.app

# =============================================================================
# Email Configuration (Optional)
# =============================================================================
# Leave blank to disable email (codes will be logged to console)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=CENTO Admin <no-reply@yourdomain.com>

# =============================================================================
# Bootstrap Admin
# =============================================================================
ADMIN_EMAIL=admin@cento.local
ADMIN_PASSWORD=
ADMIN_NAME=Admin User

# =============================================================================
# Platform-Specific Notes
# =============================================================================

# Railway.app:
# - DATABASE_URL is provided automatically
# - Don't manually set PORT - Railway handles this
# - Use Railway's environment variable UI for secrets

# Render.com:
# - DATABASE_URL from database service connection
# - PORT can be set or use Render's default
# - Use Render's environment variable dashboard

# Vercel (if adapting backend):
# - Need external PostgreSQL (Neon, Supabase, Railway)
# - All vars go in Vercel environment settings
# - May need to adapt code for serverless execution
