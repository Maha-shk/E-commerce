# =============================================================================
# CENTO Backend - Production Environment Variables
# =============================================================================
# This file is for production deployment
# For local development, use .env (copy from .env.example)
# =============================================================================

# --- Runtime -----------------------------------------------------------------
NODE_ENV=production
PORT=4000

# --- Database (PostgreSQL) ----------------------------------------------------
# IMPORTANT: Replace with your actual production database URL
# Get this from Railway, Render, or your PostgreSQL hosting service
DATABASE_URL=postgresql://postgres:your_password@your_host:5432/your_database?schema=public

# --- JWT authentication -------------------------------------------------------
# CRITICAL: Generate secure random secrets for production
# Generate with: openssl rand -base64 48
# Use DIFFERENT secrets than development
JWT_ACCESS_SECRET=REPLACE_WITH_LONG_RANDOM_SECRET_MIN_16_CHARS
JWT_REFRESH_SECRET=REPLACE_WITH_DIFFERENT_LONG_RANDOM_SECRET
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# --- CORS ---------------------------------------------------------------------
# Comma-separated list of allowed frontend origins
# Update with your production domain
CORS_ORIGIN=https://admin.cento-servizi.it

# --- Email / SMTP Configuration ------------------------------------------------
# IMPORTANT: Configure these for email functionality
# Get SMTP credentials from your email provider
# Options: Gmail, SendGrid, Mailgun, Amazon SES, etc.

# For Gmail: Create App Password at https://myaccount.google.com/apppasswords
# For SendGrid: Create API key at https://sendgrid.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password

# From address for outgoing emails
MAIL_FROM=CENTO Admin <no-reply@cento-servizi.it>

# --- Bootstrap Admin Account ---------------------------------------------------
# This admin account will be created on first run
# IMPORTANT: Change these credentials before production deployment
ADMIN_EMAIL=admin@cento.local
ADMIN_PASSWORD=ChangeMe123!
ADMIN_NAME=Alessandro Cento

# =============================================================================
# DEPLOYMENT NOTES:
# =============================================================================
# 1. For Railway deployment:
#    - These values should be set in Railway environment variables
#    - Railway will automatically inject them at runtime
#    - Don't commit real credentials to GitHub
#
# 2. For manual deployment:
#    - Copy this file to .env
#    - Fill in real values
#    - Ensure file permissions are secure (chmod 600 .env)
#
# 3. Security requirements:
#    - JWT secrets must be long random strings (min 16 chars)
#    - Database URL must be production-ready
#    - SMTP credentials must be valid
#    - Change admin password immediately after first login
#
# 4. Database migration:
#    - After deployment, run: npx prisma migrate deploy
#    - Create admin user: npx prisma db seed
#    - Or let Railway auto-migrate on deploy
# =============================================================================