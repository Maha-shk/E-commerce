# =============================================================================
# CENTO Admin Backend — environment template
# -----------------------------------------------------------------------------
# Local setup:   cp .env.example .env   then fill in the real values.
#
# There is no separate production env file: the deployed backend reads the same
# variable names from Netlify → Site configuration → Environment variables, and
# points at the same Supabase database.
# =============================================================================

# --- Runtime -----------------------------------------------------------------
# development | production | test
NODE_ENV=development
# The frontend expects the API at http://localhost:4000/api
PORT=4000

# --- Database (Supabase Postgres via the Supavisor pooler) -------------------
# Copy both strings from: Supabase dashboard → Connect → ORMs → Prisma.
#
# Always use the *.pooler.supabase.com host. The direct db.<ref>.supabase.co host
# resolves to IPv6 only, and neither a typical home network nor AWS Lambda (which
# Netlify Functions run on) can route to it.
#
#   DATABASE_URL -> port 6543, transaction mode. Runtime queries; serverless-safe.
#   DIRECT_URL   -> port 5432, session mode. prisma migrate / db seed only.
#
# Keep connect_timeout=30. Prisma's 5s default can expire mid-TLS-handshake on a
# long route and reports the misleading "P1001 Can't reach database server".
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&sslmode=require&connect_timeout=30
DIRECT_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=require&connect_timeout=30

# --- Supabase API -------------------------------------------------------------
# Project Settings → API
SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=
# Server-side only — bypasses row-level security. Never expose to a browser.
SUPABASE_SERVICE_ROLE_KEY=

# --- JWT authentication -------------------------------------------------------
# Long random strings, at least 16 chars, different from each other.
# Generate with:   openssl rand -base64 48
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# --- CORS ---------------------------------------------------------------------
# Comma-separated allowed frontend origins. Credentials are enabled, so "*" is
# not a valid value here. No trailing slashes — the browser's Origin header
# never has one, so "https://example.com/" would never match.
CORS_ORIGIN=http://localhost:3000,https://your-frontend.vercel.app

# --- Email / SMTP (OTP verification & password reset) -------------------------
# OPTIONAL. Leave SMTP_HOST blank to print codes to the backend console instead.
#  * Gmail:    App Password at https://myaccount.google.com/apppasswords
#              (needs 2-Step Verification). HOST=smtp.gmail.com PORT=587
#  * Mailtrap: https://mailtrap.io — sandbox inbox for testing
#  * Resend:   https://resend.com/smtp
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=CENTO Admin <no-reply@cento.local>

# --- Bootstrap admin (created by `npm run db:seed`) ---------------------------
# Local-only: these are read by prisma/seed.ts and nothing else, so they do NOT
# belong in the deployed environment. ADMIN_PASSWORD has no default — seeding
# fails without it rather than creating an admin with a guessable password.
ADMIN_EMAIL=admin@cento.local
ADMIN_PASSWORD=
ADMIN_NAME=Alessandro Cento

# Platform operator: a SUPER_ADMIN that belongs to no store. It creates tenants
# (POST /api/platform/tenants) and can administer any of them by sending an
# X-Tenant-Slug header. Must differ from ADMIN_EMAIL.
# Defaults to platform@<domain of ADMIN_EMAIL>.
PLATFORM_ADMIN_EMAIL=platform@cento.local

# ---------------------------------------------------------------------------
# Multi-tenancy
# ---------------------------------------------------------------------------
# Which store a request belongs to is resolved, in order, from:
#   1. the signed-in user JWT   2. X-Tenant-Slug / X-Tenant-Id header
#   3. the request Host (Tenant.domain, then the leading subdomain)
#   4. ?tenant=<slug>           5. the only tenant, if there is just one
#   6. this fallback
# Keep it set for single-store deployments and local development. Set it to an
# empty value in a real multi-tenant deployment so an unidentified request is
# rejected instead of landing in one particular store.
TENANT_FALLBACK_SLUG=default

# --- Cloudinary -------------------------------------------------------
# Image uploads (avatars, banners, product art). Cloud name is public;
# the API secret is NOT — keep it out of the frontend and out of git.
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
