# =============================================================================
# CENTO Admin Backend — environment configuration
# -----------------------------------------------------------------------------
# Copy this file to `.env` and fill in real values:   cp .env.example .env
# When running via the root `docker compose up`, most of these are supplied by
# docker-compose.yml automatically — you only need this file for running the
# backend directly with `npm run start:dev` outside Docker.
# =============================================================================

# --- Runtime -----------------------------------------------------------------
# development | production | test
NODE_ENV=development
# Port the API listens on. The frontend expects the API at http://localhost:4000/api
PORT=4000

# --- Database (PostgreSQL) ----------------------------------------------------
# Connection string Prisma uses. Format:
#   postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
# * Running locally (Postgres on your machine): use localhost.
# * Inside Docker: the host is the compose service name `postgres` (see below).
DATABASE_URL=postgresql://cento:cento_password@localhost:5432/cento?schema=public

# --- JWT authentication -------------------------------------------------------
# Secrets used to sign access & refresh tokens. MUST be long random strings.
# Generate one with:   openssl rand -base64 48
# Never commit the real values. Use different secrets for access vs refresh.
JWT_ACCESS_SECRET=replace-with-a-long-random-string-min-16-chars
JWT_REFRESH_SECRET=replace-with-a-different-long-random-string
# Token lifetimes. Access is short-lived; refresh is long-lived.
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# --- CORS ---------------------------------------------------------------------
# Comma-separated list of allowed frontend origins (credentials enabled).
CORS_ORIGIN=http://localhost:3000

# --- Email / SMTP (for OTP verification & password reset) ---------------------
# OPTIONAL. If these are left blank, verification/reset codes are printed to the
# backend console instead of being emailed — handy for local development.
#
# Where to get real SMTP credentials:
#  * Gmail:    create an "App Password" at https://myaccount.google.com/apppasswords
#              (requires 2-Step Verification). HOST=smtp.gmail.com PORT=587
#  * Mailtrap: free sandbox for testing — https://mailtrap.io (Inboxes → SMTP Settings)
#  * SendGrid: https://sendgrid.com  (Settings → API Keys). HOST=smtp.sendgrid.net
#              USER is the literal word "apikey", PASSWORD is your API key.
#  * Resend:   https://resend.com/smtp
SMTP_HOST= 
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
# The From header on outgoing emails.
MAIL_FROM=CENTO Admin <no-reply@cento.local>

# --- Bootstrap admin (created by `prisma db seed` on first run) ---------------
# The initial super-admin you log in with. CHANGE THE PASSWORD before any real use.
ADMIN_EMAIL=admin@cento.local
ADMIN_PASSWORD=ChangeMe123!
ADMIN_NAME=Alessandro Cento
