# =============================================================================
# Netlify Production Environment Variables
# =============================================================================
# Set these in your Netlify dashboard under Site Settings > Environment Variables

# Database - Use a managed PostgreSQL service (Neon, Supabase, etc.)
DATABASE_URL=postgresql://user:password@host:port/database?sslmode=require

# Node Environment
NODE_ENV=production

# JWT Authentication (generate with: openssl rand -base64 48)
JWT_ACCESS_SECRET=your-production-jwt-access-secret
JWT_REFRESH_SECRET=your-production-jwt-refresh-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# CORS - Add your frontend domains
CORS_ORIGIN=https://your-frontend.vercel.app,https://your-custom-domain.com

# Email/SMTP (optional - for password reset)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=CENTO Admin <no-reply@cento.local>

# Bootstrap Admin
ADMIN_EMAIL=admin@cento.local
ADMIN_PASSWORD=ChangeMe123!
ADMIN_NAME=Super Admin
