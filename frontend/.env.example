# =============================================================================
# Frontend environment configuration
# -----------------------------------------------------------------------------
# Copy to `.env.local` for local development:   cp .env.example .env.local
# For the Vercel deploy, set these in the Vercel dashboard instead — .env files
# are gitignored and never reach the build there.
#
# NOTE: variables must be prefixed with NEXT_PUBLIC_ to be readable in the
# browser. They are inlined into the client bundle at BUILD time, so changing
# one requires a rebuild. Never put secrets in a NEXT_PUBLIC_ variable.
# =============================================================================

# Base URL of the NestJS backend API (note the /api suffix, no trailing slash).
#   local backend:    http://localhost:4000/api
#   deployed backend: https://pr-e-commerce.netlify.app/api
NEXT_PUBLIC_API_URL=http://localhost:4000/api

# --- Supabase (browser-safe values only) --------------------------------------
# Publishable key only. The secret key belongs in backend/.env, never here.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
