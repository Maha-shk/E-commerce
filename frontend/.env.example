# =============================================================================
# Frontend environment configuration
# -----------------------------------------------------------------------------
# Copy to `.env.local` for local development:   cp .env.example .env.local
# When running via `docker compose up`, this value is supplied at build time by
# docker-compose.yml (see the `frontend.build.args` section) — no file needed.
#
# NOTE: variables must be prefixed with NEXT_PUBLIC_ to be readable in the
# browser. They are inlined into the client bundle at BUILD time, so changing
# one requires a rebuild. Never put secrets in a NEXT_PUBLIC_ variable.
# =============================================================================

# Base URL of the NestJS backend API (note the /api suffix).
NEXT_PUBLIC_API_URL=http://localhost:4000/api
