# =============================================================================
# Frontend environment configuration
# -----------------------------------------------------------------------------
# Copy to `.env.local` for local development:   cp .env.example .env.local
# For the Vercel deploy, set these in the Vercel dashboard instead — .env files
# are gitignored and never reach the build there.
#
# NOTE: variables must be prefixed with NEXT_PUBLIC_ to be readable in the
# browser. They are inlined into the client bundle at BUILD time, so changing
# one requires a rebuild. Never put secrets in a NEXT_PUBLIC_ variable.
# =============================================================================

# Base URL of the NestJS backend API (note the /api suffix, no trailing slash).
#   local backend:    http://localhost:4000/api
#   deployed backend: https://pr-e-commerce.netlify.app/api
NEXT_PUBLIC_API_URL=http://localhost:4000/api

# --- Multi-store --------------------------------------------------------------
# Which store this build talks to, sent as `X-Tenant-Slug` on every request.
#
# Leave it EMPTY for a single-store deployment. The server resolves the tenant
# itself — signed JWT, then this header, then hostname, then the backend's
# TENANT_FALLBACK_SLUG — so localhost already reaches the default store.
#
# Set it only when several stores share one hostname (typically local
# development against a second tenant). In production, serving each store from
# its own domain is preferable: the hostname then identifies the store and
# there is no build-time value to keep in sync.
NEXT_PUBLIC_TENANT_SLUG=

# --- Supabase (browser-safe values only) --------------------------------------
# Publishable key only. The secret key belongs in backend/.env, never here.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
