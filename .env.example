# =============================================================================
# Root environment file for `docker compose`
# -----------------------------------------------------------------------------
# Copy to `.env` (same folder as docker-compose.yml):   cp .env.example .env
# `docker compose up` reads this automatically. Every value has a safe default
# in docker-compose.yml, so the stack boots even with an empty .env — but you
# SHOULD set real secrets before exposing anything beyond your machine.
# =============================================================================

# --- PostgreSQL ---------------------------------------------------------------
POSTGRES_USER=cento
POSTGRES_PASSWORD=cento_password
POSTGRES_DB=cento
# Host port to reach Postgres from your machine (container port stays 5432).
POSTGRES_PORT=5432

# --- Ports on the host --------------------------------------------------------
BACKEND_PORT=4000
FRONTEND_PORT=3000

# --- JWT secrets --------------------------------------------------------------
# Generate strong values:  openssl rand -base64 48
JWT_ACCESS_SECRET=replace-with-a-long-random-string-min-16-chars
JWT_REFRESH_SECRET=replace-with-a-different-long-random-string
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# --- Frontend <-> Backend wiring ----------------------------------------------
# Origin(s) the backend accepts CORS requests from.
CORS_ORIGIN=http://localhost:3000
# API base URL baked into the frontend bundle.
NEXT_PUBLIC_API_URL=http://localhost:4000/api

# --- Seeding / bootstrap admin ------------------------------------------------
# Set to false after the first successful boot if you don't want re-seeding.
SEED_ON_START=true
ADMIN_EMAIL=admin@cento.local
ADMIN_PASSWORD=ChangeMe123!
ADMIN_NAME=Alessandro Cento

# --- Email / SMTP (optional; blank => codes are logged to backend container) ---
# See backend/.env.example for provider-specific setup notes (Gmail, Mailtrap, ...).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=CENTO Admin <no-reply@cento.local>
